DATABASE_URL=postgres://deployment:password@localhost:5432/deployments_db?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@localhost:5666/

# Empty uses the default kubeconfig or the in-cluster service account.
KUBECONFIG=
KUBERNETES_NAMESPACE=default

# JSON object: key ID -> base64-encoded AES key (16, 24, or 32 bytes).
# Use the same keys and IDs that were used to encrypt the environment values.
# Empty keys are sufficient only for deployments without encrypted environment values.
DEPLOYMENT_ENCRYPTION_KEYS={}
